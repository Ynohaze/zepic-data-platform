FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY orchestration/requirements-source-api.txt /tmp/requirements-source-api.txt
RUN pip install --no-cache-dir -r /tmp/requirements-source-api.txt

COPY src /app/src

CMD ["uvicorn", "src.source_api:app", "--host", "0.0.0.0", "--port", "8000"]
